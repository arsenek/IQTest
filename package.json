{
  "name": "iqtest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test tests/e2e/happy-path.spec.ts",
    "pri:generate": "vite-node scripts/generate-pri-items.ts --",
    "pri:check": "vite-node scripts/generate-pri-items.ts -- --check",
    "pri:sheets": "vite-node scripts/render-pri-contact-sheets.ts --",
    "vci:generate": "vite-node scripts/generate-vci-items.ts --",
    "vci:check": "vite-node scripts/generate-vci-items.ts -- --check",
    "psi:generate": "vite-node scripts/generate-psi-items.ts --",
    "psi:check": "vite-node scripts/generate-psi-items.ts -- --check",
    "wmi:generate": "vite-node scripts/generate-wmi-items.ts --",
    "wmi:check": "vite-node scripts/generate-wmi-items.ts -- --check",
    "db:up": "bash scripts/db-up.sh",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:smoke": "node scripts/smoke-persist.mjs",
    "export:responses": "vite-node -c vitest.config.ts scripts/export-responses.ts --"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "next": "15.5.29",
    "prisma": "^6.19.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
